{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"FinRunbook portfolio snapshot v1",
  "type":"object",
  "required":["schema_version","snapshot_id","generated_at","currency","mode","market","experts","refresh","limitations"],
  "properties":{
    "schema_version":{"const":1},
    "snapshot_id":{"type":"string"},
    "generated_at":{"type":"string","format":"date-time"},
    "currency":{"const":"USD"},
    "mode":{"const":"valuation_only"},
    "market":{"type":"object"},
    "refresh":{"type":"object"},
    "operations":{"type":"object","properties":{"last_check_at":{"type":["string","null"],"format":"date-time"},"source_health":{"type":["object","null"]},"service":{"type":"object"}}},
    "limitations":{"type":"array","items":{"type":"string"}},
    "experts":{"type":"array","items":{"$ref":"#/$defs/expert"}}
  },
  "$defs":{
    "amount":{"type":["string","null"],"pattern":"^-?[0-9]+(?:\\.[0-9]+)?$"},
    "expert":{
      "type":"object",
      "required":["expert_id","name","account_id","status","cash","holdings","positions","holdings_value","total_value","profit_loss","return_pct","warnings"],
      "properties":{
        "expert_id":{"type":"string"},"name":{"type":"string"},"account_id":{"type":["string","null"]},
        "status":{"enum":["not_started","account_error","account_changed","cash_only","fresh","market_closed","stale","unavailable"]},
        "research_status":{"enum":["queued","researching","reviewing","blocked","completed"]},
        "research_note":{"type":"string"},
        "operations":{"type":"object","properties":{"job_id":{"type":["string","null"]},"eligibility":{"enum":["due","not_due","unknown"]},"stages":{"type":"object"},"presentation":{"type":"object"},"execution_queue":{"type":"array"},"receipt_url":{"type":["string","null"]}}},
        "description":{"type":"string"},
        "cadence_description":{"type":"string"},
        "decision_summary":{"type":"string"},
        "research_history":{"type":"array","items":{"type":"object","required":["research_id","title","at","source","report_url","artifact_url"],"properties":{"research_id":{"type":"string"},"decision_id":{"type":["string","null"]},"title":{"type":"string"},"at":{"type":["string","null"]},"report_url":{"type":["string","null"]},"artifact_url":{"type":["string","null"]}}}},
        "runtime":{"type":"object","properties":{"liveness":{"const":"not_measured"},"observed_at":{"type":"string","format":"date-time"},"schedule_url":{"type":"string"},"schedule":{"type":"object"},"error":{"type":"string"}}},
        "pending_decision_id":{"type":["string","null"]},
        "cash":{"$ref":"#/$defs/amount"},"initial_capital":{"$ref":"#/$defs/amount"},
        "holdings":{"type":"object","additionalProperties":{"type":"integer","minimum":1}},
        "holdings_value":{"$ref":"#/$defs/amount"},"total_value":{"$ref":"#/$defs/amount"},"profit_loss":{"$ref":"#/$defs/amount"},"return_pct":{"$ref":"#/$defs/amount"},
        "warnings":{"type":"array","items":{"type":"string"}},
        "trades":{"type":"array","items":{"type":"object","required":["symbol","side","shares","fill_price","fees","decision_id"],"properties":{"fill_price":{"$ref":"#/$defs/amount"},"fees":{"$ref":"#/$defs/amount"},"side":{"enum":["buy","sell"]},"shares":{"type":"integer","minimum":1}}}},
        "decisions":{"type":"array","items":{"type":"object","required":["decision_id","action","rationale","execution_changes","record_url","report_status","evidence_status"],"properties":{"decision_id":{"type":"string"},"report_url":{"type":["string","null"]},"evidence_url":{"type":["string","null"]},"execution_changes":{"type":"array"}}}},
        "positions":{"type":"array","items":{"type":"object","required":["symbol","shares","price","market_value","price_as_of","status"],"properties":{
          "average_buy_price":{"$ref":"#/$defs/amount"},"cost_basis":{"$ref":"#/$defs/amount"},"unrealized_profit_loss":{"$ref":"#/$defs/amount"},"unrealized_return_pct":{"$ref":"#/$defs/amount"},"cost_basis_status":{"enum":["reconciled","unavailable"]},"decision_ids":{"type":"array","items":{"type":"string"}},
          "symbol":{"type":"string"},"shares":{"type":"integer","minimum":1},"price":{"$ref":"#/$defs/amount"},"market_value":{"$ref":"#/$defs/amount"},"price_as_of":{"type":["string","null"],"format":"date-time"},"status":{"enum":["unavailable","stale","fresh","market_closed"]}
        }}}
      }
    }
  }
}

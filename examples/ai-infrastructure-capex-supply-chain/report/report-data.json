    {
      "id": "value-flow",
      "type": "analysis",
      "title": "How to read the value flow without double counting",
      "content": [
        {
          "label": "Buyer capex",
          "text": "A cash-flow measure of assets acquired by the four hyperscalers. It includes buildings, servers, networking and other equipment, and is not identical across issuers."
        },
        {
          "label": "Platform revenue",
          "text": "NVIDIA, Broadcom and Arista may recognize revenue for accelerators, systems or networking that become components of the same hyperscaler deployment."
        },
        {
          "label": "Upstream revenue",
          "text": "TSMC, SK hynix and Micron recognize foundry or memory revenue embedded within accelerators and systems already reflected in downstream suppliers' revenue."
        },
        {
          "label": "Facility revenue",
          "text": "Eaton and Vertiv recognize power and cooling revenue around the same datacenter build. Timing can lead or lag IT-equipment recognition."
        },
        {
          "label": "Prohibited total",
          "text": "Do not sum the eight suppliers' revenue or AI-related KPIs and call the result end-market size. These are overlapping layer measures, in different currencies and fiscal periods."
        }
      ],

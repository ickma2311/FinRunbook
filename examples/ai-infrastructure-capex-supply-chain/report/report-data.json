  "methodology": {
    "metric_definitions": [
      {
        "metric": "Hyperscaler capex",
        "definition": "Cash additions or purchases of property and equipment. Meta adds finance-lease principal; Amazon is net of proceeds and incentives."
      },
      {
        "metric": "Revenue and operating income",
        "definition": "Reported GAAP or local-GAAP consolidated figures unless a segment basis is labeled. Eaton uses Electrical Americas for annual relevance."
      },
      {
        "metric": "Relationship evidence",
        "definition": "Named counterparty evidence from issuer materials, filings or a regulator. A supplier's broad end-market exposure is not treated as a named customer relationship."
      },
      {
        "metric": "Latest period",
        "definition": "Most recent reported quarter or trailing period available by 2026-09-03; not a synchronized cross-company period."
      }
    ],
    "normalization": "No currency conversion is used. Annual supplier trends are compared within company, not summed or ranked by absolute revenue across currencies. Period labels retain each issuer's fiscal calendar.",
    "proxy_limitations": [
      "Hyperscaler capex is broader than AI infrastructure and does not isolate GPU, network, building, power or cooling spend.",
      "NVIDIA sells through direct and indirect channels; named adoption does not reveal customer revenue concentration.",
      "The Broadcom-Alphabet link relies on a competition-authority report because issuer disclosures do not quantify the relationship.",
      "SK hynix Q2 2026 results were preliminary and unaudited at publication.",
      "Orders and backlog definitions differ materially between Eaton and Vertiv."
